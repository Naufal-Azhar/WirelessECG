digraph DesktopModuleRelationships {
  graph [rankdir=LR, bgcolor="white", fontname="Arial", labelloc="t", label="Desktop Application - Module Relationships", fontsize=20, pad=0.25, nodesep=0.4, ranksep=0.8, splines=polyline]
  node [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#5264a3", fontname="Arial", fontsize=10, margin="0.12,0.08"]
  edge [color="#596275", fontname="Arial", fontsize=9, arrowsize=0.7]

  esp [label="ECG_Arduino_IDE.ino\nESP32 + ADS1293", fillcolor="#fff3cd", shape=box]
  main [label="main.py\nECGWindow", fillcolor="#d5f5e3"]
  serial [label="SerialThread\n(QThread)", fillcolor="#e8f8f5"]
  processor [label="ECGProcessor\npeak detection + BPM", fillcolor="#e8f8f5"]
  apnea [label="ApneaWorker\n(QThread + TensorFlow)", fillcolor="#e8f8f5"]
  ui [label="PyQt6 UI\n3 pyqtgraph plots\ncontrols + dialogs", fillcolor="#fdebd0"]
  record [label="ECGWindow recording\nbuffers + session metadata", fillcolor="#fdebd0"]
  plot [label="create_ecg_plot_image()\nMatplotlib", fillcolor="#fdebd0"]
  report [label="save_word_report()\npython-docx", fillcolor="#fdebd0"]
  files [label="reports/<session>/\nRAW CSV\nPROCESSED CSV\nAI CSV\nDOCX", fillcolor="#f5eef8"]
  model [label="models/best_apnea_model_clean_60s.keras", fillcolor="#f5eef8"]
  resources [label="resources/\nicons", fillcolor="#f5eef8"]

  esp -> serial [label="Bluetooth / serial CSV"]
  main -> serial [label="creates + connects"]
  serial -> main [label="data_received signal"]
  main -> processor [label="filtered sample (filter in ECGWindow)"]
  main -> apnea [label="60s Lead I window"]
  model -> apnea [label="load_model"]
  processor -> main [label="BPM + cardiac status"]
  apnea -> main [label="prediction_ready"]
  main -> ui [label="updates display"]
  ui -> main [label="button events"]
  main -> record [label="raw + filtered + AI buffers"]
  report -> plot [label="calls to make plot"]
  record -> report [label="patient/vitals/results"]
  report -> files [label="save"]
  record -> files [label="save CSVs"]
  resources -> ui [label="icons"]
}
